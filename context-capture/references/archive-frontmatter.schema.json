{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Archive Frontmatter",
  "type": "object",
  "oneOf": [
    {
      "title": "Raw evidence record",
      "required": [
        "id",
        "record_type",
        "source",
        "scope",
        "capture_method",
        "captured_at",
        "occurred_at",
        "people",
        "projects",
        "topics",
        "sensitivity",
        "cross_project",
        "attachments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_type": {
          "const": "raw"
        },
        "source": {
          "enum": [
            "slack",
            "backlog",
            "github",
            "chatgpt",
            "transcript",
            "manual",
            "email",
            "other"
          ]
        },
        "scope": {
          "enum": [
            "private",
            "work",
            "shared-safe"
          ]
        },
        "capture_method": {
          "enum": [
            "paste",
            "manual",
            "copy",
            "transcript",
            "import",
            "other"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "masked-work",
            "private",
            "confidential",
            "restricted",
            "unknown"
          ]
        },
        "cross_project": {
          "type": "boolean"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observer_perspective": {
          "type": "string"
        },
        "coverage_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "use_policies": {
          "type": "array",
          "items": {
            "enum": [
              "internal-reference-only",
              "private-reference-only",
              "work-internal-only",
              "do-not-share-externally",
              "rephrase-before-direct-discussion",
              "may-share-after-redaction",
              "unknown"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    {
      "title": "Derived evidence record",
      "required": [
        "id",
        "record_type",
        "source_refs",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_type": {
          "enum": [
            "derived-summary",
            "derived-timeline",
            "derived-decision",
            "derived-note",
            "derived-context",
            "derived-stance",
            "derived-analysis"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "observer_perspective": {
          "type": "string"
        },
        "coverage_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "use_policies": {
          "type": "array",
          "items": {
            "enum": [
              "internal-reference-only",
              "private-reference-only",
              "work-internal-only",
              "do-not-share-externally",
              "rephrase-before-direct-discussion",
              "may-share-after-redaction",
              "unknown"
            ]
          }
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "review_due": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revision_note": {
          "type": "string"
        },
        "analysis_kind": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  ]
}
